# ChaseKit configuration example. Copy to .env or export in your shell.
# No key in this file is real. ChaseKit v0.1 needs NO credentials for the
# CSV source, the demo, or dry-run mode.

# Your business name, used in template signatures.
CHASEKIT_BUSINESS_NAME=Your Business

# Invoice Ninja source (optional). Create an API token in your Invoice
# Ninja admin under Settings > User Management > API Tokens.
CHASEKIT_INVOICE_NINJA_URL=
CHASEKIT_INVOICE_NINJA_TOKEN=

# Email sender (only used in approve mode). Use an app password or a
# dedicated mailbox credential, never your main account password.
CHASEKIT_SMTP_HOST=
CHASEKIT_SMTP_PORT=587
CHASEKIT_SMTP_USERNAME=
CHASEKIT_SMTP_PASSWORD=
CHASEKIT_SMTP_FROM=
CHASEKIT_SMTP_STARTTLS=1
